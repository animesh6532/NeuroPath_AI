# ===============================================================================
# NeuroPath AI - Environment Variables Template
# Copy this file to '.env' and adjust variables as required for deployment.
# ===============================================================================

# ───────────────────────────────────────────────────────────────────────────────
# BACKEND CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────────

# Database connection URL.
# - SQLite (default local): sqlite:///./neuro.db
# - PostgreSQL: postgresql://username:password@host:port/database_name
DATABASE_URL=sqlite:///./neuro.db

# Flask/FastAPI Secret key for sessions/passwords hashing. Keep secret!
SECRET_KEY=generate_a_secure_random_key_in_production_here

# JWT authentication settings
JWT_SECRET=generate_a_secure_random_key_in_production_here
JWT_ALGORITHM=HS256

# Temporary file upload directory (default local: uploads)
UPLOAD_DIR=uploads

# Machine learning model storage path
MODEL_PATH=models

# Allowed CORS origins (comma-separated). Set to specific domains in production.
# Example: ALLOWED_ORIGINS=https://neuropath.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=*

# Canonical URLs used by CORS and cross-references
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Port configuration (used by Docker / Render)
PORT=8000

# ───────────────────────────────────────────────────────────────────────────────
# FRONTEND CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────────

# FastAPI endpoint. Read by Vite during compile.
VITE_API_URL=http://localhost:8000
